(define (problem complex-tyre-change)
  (:domain tyreworld)
  (:objects
    boot - container
    hub1 hub2 hub3 - hubect
    nut1 nut2 nut3 - nut
    flat1 flat2 flat3 - wheel
    intact1 intact2 intact3 - wheel
    jack pump wrench - tool
  )
  (:init
    (closed boot)
    (unlocked boot)
    (in intact1 boot)
    (in intact2 boot)
    (in intact3 boot)
    (in jack boot)
    (in pump boot)
    (in wrench boot)
    (not (inflated intact1))
    (not (inflated intact2))
    (not (inflated intact3))
    (on flat1 hub1)
    (on flat2 hub2)
    (on flat3 hub3)
    (on-ground hub1)
    (on-ground hub2)
    (on-ground hub3)
    (tight nut1 hub1)
    (tight nut2 hub2)
    (tight nut3 hub3)
    (fastened hub1)
    (fastened hub2)
    (fastened hub3)
    (intact intact1)
    (intact intact2)
    (intact intact3)
    (not (intact flat1))
    (not (intact flat2))
    (not (intact flat3))
  )
  (:goal
    (and
      (on intact1 hub1)
      (on intact2 hub2)
      (on intact3 hub3)
      (inflated intact1)
      (inflated intact2)
      (inflated intact3)
      (tight nut1 hub1)
      (tight nut2 hub2)
      (tight nut3 hub3)
      (in flat1 boot)
      (in flat2 boot)
      (in flat3 boot)
      (in wrench boot)
      (in jack boot)
      (in pump boot)
      (closed boot)
    )
  )
)