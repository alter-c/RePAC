(define (problem blocksworld-complex)
  (:domain blocksworld)
  (:objects b1 b2 b3 b4 b5 b6)
  (:init
    (on-table b2)
    (on b3 b2)
    (on b1 b3)
    (on b5 b1)
    (on b4 b5)
    (on b6 b4)
    (clear b6)
    (arm-empty)
  )
  (:goal
    (and
      (on b1 b6)
      (on b3 b5)
      (on b6 b2)
    )
  )
)