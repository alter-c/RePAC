(open boot)
(fetch jack boot)
(fetch intact_tyre1 boot)
(loosen nut1 hub1 jack)
(inflate intact_tyre1 jack)
(fetch pump boot)
(jack-up hub1 pump)
(undo nut1 hub1 jack)
(remove-wheel flat_tyre1 hub1)
(put-away flat_tyre1 boot)
(close boot)
(put-on-wheel intact_tyre1 hub1)
(do-up nut1 hub1 jack)
(jack-down hub1 pump)
(tighten nut1 hub1 pump)
(open boot)
(put-away jack boot)
(put-away pump boot)
(close boot)
; cost = 19 (unit cost)
