(define (problem replace_tyres)
  (:domain tyreworld)
  (:objects
    jack pump wrench - tool
    boot - container
    hub1 hub2 hub3 - hubect
    nut1 nut2 nut3 - nut
    flat_tyre1 flat_tyre2 flat_tyre3 - wheel
    intact_tyre1 intact_tyre2 intact_tyre3 - wheel
  )
  (:init
    (unlocked boot)
    (closed boot)
    (in jack boot)
    (in pump boot)
    (in wrench boot)
    (in intact_tyre1 boot)
    (in intact_tyre2 boot)
    (in intact_tyre3 boot)
    (not-inflated intact_tyre1)
    (not-inflated intact_tyre2)
    (not-inflated intact_tyre3)
    (intact intact_tyre1)
    (intact intact_tyre2)
    (intact intact_tyre3)
    (on flat_tyre1 hub1)
    (on flat_tyre2 hub2)
    (on flat_tyre3 hub3)
    (on-ground hub1)
    (on-ground hub2)
    (on-ground hub3)
    (fastened hub1)
    (fastened hub2)
    (fastened hub3)
    (tight nut1 hub1)
    (tight nut2 hub2)
    (tight nut3 hub3)
  )
  (:goal
    (and
      (on intact_tyre1 hub1)
      (on intact_tyre2 hub2)
      (on intact_tyre3 hub3)
      (inflated intact_tyre1)
      (inflated intact_tyre2)
      (inflated intact_tyre3)
      (tight nut1 hub1)
      (tight nut2 hub2)
      (tight nut3 hub3)
      (fastened hub1)
      (fastened hub2)
      (fastened hub3)
      (in flat_tyre1 boot)
      (in flat_tyre2 boot)
      (in flat_tyre3 boot)
      (in wrench boot)
      (in jack boot)
      (in pump boot)
      (closed boot)
    )
  )
)