(define (domain termes)
  (:requirements :typing :negative-preconditions)
  (:types numb position - object)
  (:predicates
    (height ?p ?h)
    (at ?p)
    (has-block)
    (SUCC ?n1 ?n2)
    (NEIGHBOR ?p1 ?p2)
    (IS-DEPOT ?p)
  )
  (:action move
    :parameters (?from ?to - position)
    :precondition (and (at ?from)
                       (NEIGHBOR ?from ?to)
                       (exists (?h - numb) (and (height ?from ?h) (height ?to ?h))))
    :effect (and (not (at ?from)) (at ?to))
  )
  (:action move-up
    :parameters (?from ?to - position)
    :precondition (and (at ?from)
                       (NEIGHBOR ?from ?to)
                       (exists (?h1 ?h2 - numb) (and (height ?from ?h1) (height ?to ?h2) (SUCC ?h1 ?h2))))
    :effect (and (not (at ?from)) (at ?to))
  )
  (:action move-down
    :parameters (?from ?to - position)
    :precondition (and (at ?from)
                       (NEIGHBOR ?from ?to)
                       (exists (?h1 ?h2 - numb) (and (height ?from ?h1) (height ?to ?h2) (SUCC ?h2 ?h1))))
    :effect (and (not (at ?from)) (at ?to))
  )
  (:action place-block
    :parameters (?from ?to - position ?h ?hnew - numb)
    :precondition (and (at ?from)
                       (NEIGHBOR ?from ?to)
                       (has-block)
                       (not (IS-DEPOT ?to))
                       (height ?from ?h)
                       (height ?to ?h)
                       (SUCC ?h ?hnew))
    :effect (and (not (has-block))
                 (not (height ?to ?h))
                 (height ?to ?hnew))
  )
  (:action remove-block
    :parameters (?from ?to - position ?h ?hrob - numb)
    :precondition (and (at ?from)
                       (NEIGHBOR ?from ?to)
                       (not (has-block))
                       (not (IS-DEPOT ?to))
                       (height ?to ?h)
                       (height ?from ?hrob)
                       (SUCC ?hrob ?h))
    :effect (and (has-block)
                 (not (height ?to ?h))
                 (height ?to ?hrob))
  )
  (:action create-block
    :parameters (?p - position)
    :precondition (and (at ?p) (IS-DEPOT ?p) (not (has-block)))
    :effect (has-block)
  )
  (:action destroy-block
    :parameters (?p - position)
    :precondition (and (at ?p) (IS-DEPOT ?p) (has-block))
    :effect (not (has-block))
  )
)