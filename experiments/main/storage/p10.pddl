(define (problem complex-storage)
  (:domain storage)
  (:objects
    hoist0 - hoist
    crate0 crate1 crate2 crate3 - crate
    depot48-1-1 depot48-1-2 depot48-1-3 depot48-1-4 - storearea
    depot48-2-1 depot48-2-2 depot48-2-3 depot48-2-4 - storearea
    container-0-0 container-0-1 container-0-2 container-0-3 - storearea
    loadarea - transitarea
    container0 - container
    depot48 - depot
  )
  (:init
    ; Hoist status
    (available hoist0)
    (at hoist0 depot48-1-1)
    ; Crates on container storeareas
    (on crate0 container-0-0)
    (on crate1 container-0-1)
    (on crate2 container-0-2)
    (on crate3 container-0-3)
    ; Depots and containers membership
    (in depot48-1-1 depot48)
    (in depot48-1-2 depot48)
    (in depot48-1-3 depot48)
    (in depot48-1-4 depot48)
    (in depot48-2-1 depot48)
    (in depot48-2-2 depot48)
    (in depot48-2-3 depot48)
    (in depot48-2-4 depot48)
    (in container-0-0 container0)
    (in container-0-1 container0)
    (in container-0-2 container0)
    (in container-0-3 container0)
    (in crate0 container0)
    (in crate1 container0)
    (in crate2 container0)
    (in crate3 container0)
    ; Clear storeareas (depot areas specified, plus loadarea)
    (clear depot48-1-2)
    (clear depot48-1-3)
    (clear depot48-1-4)
    (clear depot48-2-1)
    (clear depot48-2-2)
    (clear depot48-2-3)
    (clear depot48-2-4)
    (clear loadarea)
    ; Connections: container storeareas to loadarea
    (connected container-0-0 loadarea)
    (connected container-0-1 loadarea)
    (connected container-0-2 loadarea)
    (connected container-0-3 loadarea)
    ; Connection: specific depot storearea to loadarea
    (connected depot48-2-3 loadarea)
    ; Reverse connections from loadarea to storeareas (for go-in)
    (connected loadarea container-0-0)
    (connected loadarea container-0-1)
    (connected loadarea container-0-2)
    (connected loadarea container-0-3)
    (connected loadarea depot48-2-3)
    ; Adjacent depot storeareas (horizontal and vertical, bidirectional)
    (connected depot48-1-1 depot48-1-2)
    (connected depot48-1-2 depot48-1-1)
    (connected depot48-1-2 depot48-1-3)
    (connected depot48-1-3 depot48-1-2)
    (connected depot48-1-3 depot48-1-4)
    (connected depot48-1-4 depot48-1-3)
    (connected depot48-2-1 depot48-2-2)
    (connected depot48-2-2 depot48-2-1)
    (connected depot48-2-2 depot48-2-3)
    (connected depot48-2-3 depot48-2-2)
    (connected depot48-2-3 depot48-2-4)
    (connected depot48-2-4 depot48-2-3)
    (connected depot48-1-1 depot48-2-1)
    (connected depot48-2-1 depot48-1-1)
    (connected depot48-1-2 depot48-2-2)
    (connected depot48-2-2 depot48-1-2)
    (connected depot48-1-3 depot48-2-3)
    (connected depot48-2-3 depot48-1-3)
    (connected depot48-1-4 depot48-2-4)
    (connected depot48-2-4 depot48-1-4)
  )
  (:goal (and
    (in crate0 depot48) (on crate0 depot48-1-1)
    (in crate1 depot48) (on crate1 depot48-1-2)
    (in crate2 depot48) (on crate2 depot48-1-3)
    (in crate3 depot48) (on crate3 depot48-1-4)
  ))
)